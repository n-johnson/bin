#!/bin/bash

STATE_FILE="$HOME/.pdir"

if [[ $# -gt 1 ]]; then
  print_error "Usage: pset [path]"
  exit 1
fi

if [[ $# -eq 0 ]]; then
  resolved_path="$(pwd -P)"
else
  expanded_path="$(expandPath "$1")"

  if ! resolved_path="$(cd "$expanded_path" 2>/dev/null && pwd -P)"; then
    print_error "Directory not found: $1"
    exit 1
  fi
fi

if ! printf '%s\n' "$resolved_path" > "$STATE_FILE"; then
  print_error "Could not save project path to $STATE_FILE"
  exit 1
fi

printf '%s\n' "$resolved_path"
